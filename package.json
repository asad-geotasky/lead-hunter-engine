{
  "name": "lead-hunter-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"try { require('fs').rmSync('.next', { recursive: true, force: true }); } catch (e) {}\"",
    "clean:dev": "npm run clean && next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "node -e \"process.env.DATABASE_URL = process.env.DATABASE_URL || 'postgresql://postgres:postgres@localhost:5432/postgres'; require('child_process').execSync('npx prisma generate', { stdio: 'inherit', env: process.env })\"",
    "db:push": "prisma db push",
    "db:import": "tsx scripts/migrate-from-json.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.16.0",
    "next": "^15.1.0",
    "nodemailer": "^10.0.10",
    "puppeteer-core": "^25.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.4.49",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
